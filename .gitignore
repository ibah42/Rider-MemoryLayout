# --- IntelliJ Platform Gradle Plugin ---
# Кэш плагина: распакованная целевая IDE, sandbox, layout-индексы.
# Легко переваливает за гигабайт и полностью восстанавливается сборкой.
.intellijPlatform/

# --- Gradle ---
.gradle/
build/
.kotlin/
local.properties
gradle-local.properties

# Враппер, наоборот, нужен в репозитории — без него gradlew не заработает после клона
!gradle/wrapper/gradle-wrapper.jar
!gradle/wrapper/gradle-wrapper.properties

# --- IntelliJ ---
.idea/
*.iml
*.ipr
*.iws
out/

